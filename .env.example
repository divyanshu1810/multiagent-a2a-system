# ── Cohere ──────────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key_here

# ── Tavily (optional web-search fallback) ────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── MCP Server URLs ──────────────────────────────────────────────────────────
MCP_SERVER_1_URL=http://localhost:8001/mcp   # RAG / Retriever
MCP_SERVER_2_URL=http://localhost:8002/mcp   # Product & Order
MCP_SERVER_3_URL=http://localhost:8003/mcp   # Policy Resources

# ── Remote A2A Agent URLs ────────────────────────────────────────────────────
REMOTE_AGENT_1_URL=http://localhost:8010     # LangGraph CRAG Agent
REMOTE_AGENT_2_URL=http://localhost:8011     # Agno Workflow Agent

# ── Paths ────────────────────────────────────────────────────────────────────
POLICIES_DIR=./policies          # Drop your PDFs here
CHROMA_DB_DIR=./chroma_db        # Auto-created on first run
PRODUCTS_CSV=./data/products.csv
ORDERS_CSV=./data/orders.csv
POLICY_DOCS_DIR=./mcp_server_3/policy_docs
